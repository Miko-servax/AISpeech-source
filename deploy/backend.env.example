# Production backend only. Install as /etc/aispeech/backend.env, mode 600; never in web root.
TENCENT_APP_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_ASR_ENGINE=16k_zh
ALLOWED_ORIGINS=https://demo.example.com

# Optional semantic fallback. Full chat-completions-compatible endpoint URL.
INTENT_ENABLED=false
INTENT_ENDPOINT=
INTENT_MODEL=
INTENT_API_KEY=
INTENT_TIMEOUT_MS=10000
# Optional: dashscope or openai-compatible. Omit to auto-detect Qwen model names.
# DashScope requests always send enable_thinking=false at the top level.
# INTENT_PROVIDER=dashscope
# json_schema (strict schema support) or json_object (still locally validated)
INTENT_RESPONSE_FORMAT=json_schema
