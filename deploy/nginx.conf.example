# Place in the http {} context (for example /etc/nginx/conf.d/aispeech.conf).
map $http_upgrade $aispeech_connection {
    default upgrade;
    '' close;
}
server {
    listen 80;
    server_name demo.example.com;
    return 301 https://demo.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name demo.example.com;
    ssl_certificate /etc/letsencrypt/live/demo.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /opt/aispeech/current/frontend;
    index index.html;
    client_max_body_size 1m;

    # Preserve /api/...; do not add a trailing slash to proxy_pass.
    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $aispeech_connection;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Browser Origin is retained for backend allowlist checks.
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
    }
    location /models/ {
        gzip_static on;
        gzip_vary on;
        types { model/gltf-binary glb; }
        default_type application/octet-stream;
        # GLB filename is stable: revalidate instead of immutable caching.
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location = /pcm-worklet.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
    # Config, keys and dotfiles must not be served even if misplaced.
    location ~ /\. { deny all; }
}
