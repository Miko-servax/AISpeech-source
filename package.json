{
  "name": "aispeech-car-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "doctor": "node scripts/check-env.mjs",
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "dev:server": "node --env-file-if-exists=server/.env.local server/asr.mjs",
    "test:commands": "node scripts/test-commands.mjs",
    "eval:intent": "node --env-file-if-exists=server/.env.local scripts/eval-intent.mjs",
    "profile:assets": "node scripts/profile-v8.mjs",
    "build:model": "node scripts/build-v8-glb.mjs",
    "test:model": "node scripts/test-v8-release.mjs",
    "test:model:runtime": "node scripts/test-runtime-model.mjs",
    "mobile:cert": "node scripts/mobile-cert.mjs",
    "mobile": "npm run build && node scripts/mobile-serve.mjs",
    "test:mobile": "npm run mobile:cert && node scripts/test-mobile-https.mjs",
    "mobile:check": "node scripts/check-mobile-entry.mjs",
    "package:delivery": "npm run build && node scripts/package-delivery.mjs",
    "build:pages": "npm run typecheck && vite build --mode pages --base=/AISpeech-demo/ --outDir=dist-pages && node scripts/prepare-pages.mjs",
    "test:cloud": "node scripts/test-cloud-backend.mjs",
    "prepare:public-source": "node scripts/prepare-public-source.mjs",
    "package:scf": "node scripts/package-scf.mjs"
  },
  "dependencies": {
    "pinia": "^3.0.0",
    "three": "~0.180.0",
    "vue": "^3.5.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "~0.180.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0",
    "meshoptimizer": "~0.22.0"
  }
}
